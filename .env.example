# Copia este archivo a .env y cambia TODAS las claves.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac (Terminal):        cp .env.example .env
# .env no se sube a Git (está en .gitignore). Nunca pegues aquí una llave en un chat ni en un video.

# ── Claves de esta instalación (inventa las tuyas; mínimo 16 caracteres) ──
WEBHOOK_SECRETO=cambia-este-secreto-de-webhook
ADMIN_CLAVE=cambia-esta-clave-del-panel
EVOLUTION_CLAVE_GLOBAL=cambia-esta-clave-global
EVOLUTION_TOKEN_INSTANCIA=cambia-este-token-de-instancia
POSTGRES_CLAVE=cambia-esta-clave-de-postgres

# ── Quién puede hablar con el bot (solo dígitos, con código de país; separa con comas) ──
# Ejemplo para Perú: 51 + tu número de 9 dígitos. Los demás números se ignoran.
NUMEROS_PERMITIDOS=51900000000
# A quién le llegan los avisos de fallos y caídas (si lo dejas vacío, a los permitidos)
NUMEROS_ALERTA=

# ── La IA inyectada ──
# falso     = sin IA real (para probar todo sin llave)
# deepseek  = DeepSeek (modelo deepseek-flash por defecto); pide LLM_API_KEY
# ollama    = un modelo local en tu máquina (qwen2.5-coder:14b por defecto); no pide llave
# openai / openrouter = pon también LLM_MODELO
LLM_PROVEEDOR=falso
LLM_API_KEY=
LLM_MODELO=
# Cualquier otra API compatible con OpenAI: su URL base (termina antes de /chat/completions)
LLM_BASE_URL=

# evolution = WhatsApp real con Evolution Go · falso = sin teléfono (los mensajes se guardan, no se envían)
WHATSAPP=evolution

# ── Puertos (cámbialos si alguno ya está ocupado en tu máquina) ──
PUERTO_TIENDA=3000
PUERTO_BOTS=3300
PUERTO_ROBOT=3200
PUERTO_EVOLUTION=8081
PUERTO_BOT=8090
# 1 = la tienda trae sus defectos (para que los bots los encuentren) · 0 = corregida
BUGS=1
CADA_MIN=10
# Demora artificial de la tienda en milisegundos (paso 3 de los prompts)
LATENCIA_MS=0
